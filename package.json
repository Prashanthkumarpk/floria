{
  "name": "floria",
  "version": "0.0.1",
  "description": "Research Paper AI Chat — OpenUI5 + WebLLM (local) + CrossRef OData v4",
  "main": "webapp/index.html",
  "scripts": {
    "start:ui5": "fiori run --open \"index.html\"",
    "start:odata": "node srv/server.mjs",
    "ts-typecheck": "tsc --noEmit",
    "lint": "eslint ./",
    "start": "concurrently \"npm run start:odata\" \"npm run start:ui5\"",
    "start-local": "fiori run --config ./ui5-local.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#app-tile\"",
    "start-noflp": "fiori run --open \"index.html?sap-ui-xx-viewCache=false\"",
    "start-variants-management": "fiori run --open \"preview.html?sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#preview-app\"",
    "build": "ui5 build -a --clean-dest --include-task=generateCachebusterInfo",
    "deploy": "fiori verify",
    "deploy-config": "fiori add deploy-config",
    "prestart": "npm run ts-typecheck",
    "prebuild": "npm run ts-typecheck",
    "postinstall": "node scripts/setup-libs.mjs"
  },
  "devDependencies": {
    "@openui5/types": "~1.130.0",
    "concurrently": "^8.2.0",
    "eslint": "^9",
    "typescript": "^5.9.3",
    "ui5-tooling-transpile": "^3.10.0",
    "@ui5/cli": "^4.0.0",
    "@sap/ux-ui5-tooling": "1",
    "rimraf": "6.0.1",
    "@sapui5/types": "~1.120.0"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "cors": "^2.8.5",
    "express": "^4.18.0"
  },
  "private": true,
  "sapuxLayer": "CUSTOMER_BASE",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "allowScripts": {
    "ui5-tooling-transpile@3.13.1": true
  }
}
